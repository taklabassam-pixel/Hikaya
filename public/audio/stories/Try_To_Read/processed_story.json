{
    "total_chunks": 48,
    "chunks": [
        {
            "id": 1,
            "text": "حَاوِلِي أَنْ تَقْرَئِي",
            "imageAsset": "/audio/stories/Try_To_Read/scene_1.png"
        },
        {
            "id": 2,
            "text": "كَانَتْ هَلَا سَعِيدَةً جِدّاً"
        },
        {
            "id": 3,
            "text": "وَشَعَرَتْ أَنَّ كُلَّ مَا حَوْلَهَا سَعِيدْ"
        },
        {
            "id": 4,
            "text": "سَأَلَتْهَا صَدِيقَتُهَا رِيمُ عَنْ سَبَبِ سَعَادَتِهَا"
        },
        {
            "id": 5,
            "text": "فَأَجَابَتْهَا وَهِيَ تَبْتَسِمْ: الْيَوْمَ آخِرُ يَوْمٍ لَنَا فِي الْمَدْرَسَةْ"
        },
        {
            "id": 6,
            "text": "أَخَذَتْ هَلَا تُفَكِّرْ"
        },
        {
            "id": 7,
            "text": "فَهِيَ عِنْدَمَا تَعُودُ إِلَى الْبَيْتِ لَنْ تَكُونَ بِحَاجَةٍ إِلَى أَنْ تَقْرَأَ أَوْ تَكْتُبْ"
        },
        {
            "id": 8,
            "text": "وَلَنْ تَسْتَيْقِظَ مُبَكِّرَةً طَوَالَ الْعُطْلَةِ الصَّيْفِيَّةْ"
        },
        {
            "id": 9,
            "text": "وَصَلَتْ هَلَا إِلَى الْبَيْتِ",
            "imageAsset": "/audio/stories/Try_To_Read/scene_9.png"
        },
        {
            "id": 10,
            "text": "حَيَّتْ أُمَّهَا وَأَبَاهَا"
        },
        {
            "id": 11,
            "text": "ثُمَّ اتَّجَهَتْ إِلَى غُرْفَتِهَا"
        },
        {
            "id": 12,
            "text": "لَقَدْ قَرَّرَتْ أَنْ تَفْعَلَ شَيْئاً خَطِيراً"
        },
        {
            "id": 13,
            "text": "أَمْسَكَتْ هَلَا بِكُتُبِهَا"
        },
        {
            "id": 14,
            "text": "ثُمَّ صَعَدَتِ السُّلَّمَ؛ لِتَرْمِيَهَا فِي مُسْتَوْدَعِ الْبَيْتِ الْمَهْجُورْ"
        },
        {
            "id": 15,
            "text": "انْتَبَهَ وَالِدُ هَلَا إِلَى إِهْمَالِهَا كُتُبَهَا"
        },
        {
            "id": 16,
            "text": "وَهَجْرِهَا لَهَا"
        },
        {
            "id": 17,
            "text": "فَصَمَّمَ أَنْ يُعَلِّمَهَا دَرْساً لَنْ تَنْسَاهُ"
        },
        {
            "id": 18,
            "text": "وَفِي مَسَاءِ الْيَوْمِ الثَّانِي",
            "imageAsset": "/audio/stories/Try_To_Read/scene_18.png"
        },
        {
            "id": 19,
            "text": "قَدَّمَ وَالِدُ هَلَا لاِبْنَتِهِ الصَّغِيرَةِ أَلْعَاباً جَمِيلَةً"
        },
        {
            "id": 20,
            "text": "فَفَرِحَتْ بِذَلِكَ كَثِيراً"
        },
        {
            "id": 21,
            "text": "وَلَكِنَّ فَرَحَهَا لَمْ يَدُمْ طَوِيلاً"
        },
        {
            "id": 22,
            "text": "كَانَ عَلَى هَلَا أَنْ تَجْمَعَ قِطَعَ كُلِّ لُعْبَةٍ حَتَّى تَتَمَكَّنَ مِنَ اللَّعِبِ بِهَا"
        },
        {
            "id": 23,
            "text": "وَلَكِنَّهَا لَمْ تَسْتَطِعْ"
        },
        {
            "id": 24,
            "text": "طَلَبَتْ مِنْ أَبِيهَا أَنْ يُسَاعِدَهَا"
        },
        {
            "id": 25,
            "text": "فَقَالَ لَهَا: حَاوِلِي أَنْ تَقْرَئِي"
        },
        {
            "id": 26,
            "text": "فَقَالَتْ هَلَا: وَلَكِنِّي لَا أَعْرِفُ الْقِرَاءَةَ"
        },
        {
            "id": 27,
            "text": "ذَهَبَتْ هَلَا لِمُشَاهَدَةِ بَرَامِجِ الْأَطْفَالِ فِي التِّلْفَازِ",
            "imageAsset": "/audio/stories/Try_To_Read/scene_27.png"
        },
        {
            "id": 28,
            "text": "وَقَالَتْ: بِالتَّأْكِيدِ سَتَكُونُ أَجْمَلَ مِنَ الْقِرَاءَةِ وَاللَّعِبِ"
        },
        {
            "id": 29,
            "text": "لَمْ تَفْهَمْ هَلَا مَا يَدُورُ فِي قِصَصِ تِلْكَ الْبَرَامِجِ"
        },
        {
            "id": 30,
            "text": "فَلَقَدْ كَانَتْ بِاللُّغَةِ الْإِنْجِلِيزِيَّةِ"
        },
        {
            "id": 31,
            "text": "طَلَبَتْ مِنْ وَالِدِهَا أَنْ يَقْرَأَ لَهَا التَّرْجَمَةَ"
        },
        {
            "id": 32,
            "text": "فَقَالْ: حَاوِلِي أَنْ تَقْرَئِي"
        },
        {
            "id": 33,
            "text": "فَرَدَّتْ بِصَوْتٍ ضَعِيفْ: وَلَكِنِّي لَا أَعْرِفُ الْقِرَاءَةَ"
        },
        {
            "id": 34,
            "text": "تَنَاوَلَتْ هَلَا بَعْضَ الْقِصَصِ الْمُلَوَّنَةِ"
        },
        {
            "id": 35,
            "text": "الَّتِي فِيهَا صُوَرٌ جَمِيلَةٌ"
        },
        {
            "id": 36,
            "text": "رَجَتْ وَالِدَهَا أَنْ يَقْرَأَهَا لَهَا"
        },
        {
            "id": 37,
            "text": "فَقَالْ: حَاوِلِي أَنْ تَقْرَئِي"
        },
        {
            "id": 38,
            "text": "فَقَالَتْ: وَلَكِنِّي لَا أَعْرِفُ الْقِرَاءَةَ"
        },
        {
            "id": 39,
            "text": "أَحَسَّتْ هَلَا بِالضِّيقِ الشَّدِيدِ",
            "imageAsset": "/audio/stories/Try_To_Read/scene_39.png"
        },
        {
            "id": 40,
            "text": "فَهِيَ لَا تَسْتَطِيعُ أَنْ تَعْمَلَ شَيْئاً دُونَ الْقِرَاءَةِ"
        },
        {
            "id": 41,
            "text": "جَلَسَتْ هَلَا فِي غُرْفَتِهَا حَزِينَةً"
        },
        {
            "id": 42,
            "text": "وَأَخَذَتْ تَبْكِي وَتَبْكِي"
        },
        {
            "id": 43,
            "text": "دَخَلَ وَالِدُ هَلَا إِلَى غُرْفَتِهَا وَقَالَ لَهَا: أَرَأَيْتِ يَا هَلَا مَا فَائِدَةُ الْكُتُبِ الَّتِي لَمْ تَهْتَمِّي بِهَا"
        },
        {
            "id": 44,
            "text": "وَقُمْتِ بِوَضْعِهَا فِي الْمُسْتَوْدَعِ"
        },
        {
            "id": 45,
            "text": "لَمْ تُجِبْ هَلَا بِأَيِّ كَلِمَةٍ"
        },
        {
            "id": 46,
            "text": "بَلْ أَسْرَعَتْ إِلَى الْمُسْتَوْدَعِ",
            "imageAsset": "/audio/stories/Try_To_Read/scene_46.png"
        },
        {
            "id": 47,
            "text": "وَجَمَعَتْ كُتُبَهَا"
        },
        {
            "id": 48,
            "text": "وَضَمَّتْهَا إِلَى صَدْرِهَا وَهِيَ تَقُولْ: مَا أَجْمَلَ الْحَيَاةَ مَعَ هَذِهِ الْكُتُبِ الرَّائِعَةِ"
        }
    ]
}