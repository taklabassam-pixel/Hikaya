{
    "total_chunks": 77,
    "chunks": [
        {
            "id": 1,
            "text": "قِصَّةُ الْفِيلِ وَالْأَصْدِقَاءِ",
            "imageAsset": "/audio/stories/Elephant_and_friends/scene_1.png"
        },
        {
            "id": 2,
            "text": "كَانَ يَا مَا كَانَ"
        },
        {
            "id": 3,
            "text": "فِي قَدِيمِ الزَّمَانِ"
        },
        {
            "id": 4,
            "text": "فِيلٌ طَيِّبٌ وَوَحِيدٌ يَتَجَوَّلُ فِي أَرْجَاءِ الْغَابَةِ الْخَضْرَاءِ بَحْثاً عَنْ أَصْدِقَاءَ يُؤْنِسُونَ وَحْدَتَهُ"
        },
        {
            "id": 5,
            "text": "صَادَفَ الْفِيلُ قِرْداً ذَكِيّاً يَتَحَرَّكُ بِخِفَّةٍ",
            "imageAsset": "/audio/stories/Elephant_and_friends/scene_5.png"
        },
        {
            "id": 6,
            "text": "فَاقْتَرَبَ مِنْهُ وَسَأَلَهُ بِلُطْفٍ:"
        },
        {
            "id": 7,
            "text": "هَلْ تُوَافِقُ بِأَنْ تَكُونَ صَدِيقِي"
        },
        {
            "id": 8,
            "text": "أَيُّهَا الْقِرْدُ"
        },
        {
            "id": 9,
            "text": "فَأَجَابَهُ الْقِرْدُ بِغُرُورٍ:"
        },
        {
            "id": 10,
            "text": "\"أَنْتَ كَبِيرٌ جِدّاً"
        },
        {
            "id": 11,
            "text": "وَلَا يُمْكِنُكَ التَّأَرْجُحُ عَلَى الْأَشْجَارِ مِثْلِي"
        },
        {
            "id": 12,
            "text": "لِذَلِكَ لَا أَسْتَطِيعُ أَنْ أَكُونَ صَدِيقَكَ\""
        },
        {
            "id": 13,
            "text": "مَضَى الْفِيلُ وَهُوَ يُطْأطِئُ رَأْسَهُ"
        },
        {
            "id": 14,
            "text": "وَتَسَاءَلَ فِي نَفْسِهِ بِحُزْنٍ:"
        },
        {
            "id": 15,
            "text": "(لِمَ يَجِبُ عَلَيَّ أَنْ أَتَأَرْجَحَ بَيْنَ الْأَغْصَانِ لِأَكُونَ مَحْبُوباً؟"
        },
        {
            "id": 16,
            "text": "لِمَ تُعَابُ ضَخَامَتِي هَذِهِ؟"
        },
        {
            "id": 17,
            "text": "وَهَلِ الْخِفَّةُ وَحْدَهَا هِيَ مِعْيَارُ الصَّدَاقَةِ؟)"
        },
        {
            "id": 18,
            "text": "حَزِنَ الْفِيلُ قَلِيلاً"
        },
        {
            "id": 19,
            "text": "ثُمَّ مَضَى فِي طَرِيقِهِ يَبْحَثُ مِنْ جَدِيدٍ"
        },
        {
            "id": 20,
            "text": "فَصَادَفَ أَرْنَباً صَغِيراً يَقْفِزُ بِنَشَاطٍ",
            "imageAsset": "/audio/stories/Elephant_and_friends/scene_20.png"
        },
        {
            "id": 21,
            "text": "فَسَأَلَهُ إِنْ كَانَ يُوَافِقُ أَنْ يَكُونَ صَدِيقاً لَهُ"
        },
        {
            "id": 22,
            "text": "فَأَجَابَهُ الْأَرْنَبُ بِسُخْرِيَةٍ:"
        },
        {
            "id": 23,
            "text": "\"أَنْتَ أَكْبَرُ مِنْ أَنْ تَتَسَعَ دَاخِلَ جُحْرِي الصَّغِيرِ"
        },
        {
            "id": 24,
            "text": "وَلَا تَقْدِرُ عَلَى اللَّعِبِ مَعِي"
        },
        {
            "id": 25,
            "text": "فَلَا مَكَانَ لَكَ بَيْنَنَا\""
        },
        {
            "id": 26,
            "text": "تَفَكَّرَ الْفِيلُ مَلِيّاً بِمَا قَالَهُ الْأَرْنَبُ"
        },
        {
            "id": 27,
            "text": "وَحَدَّثَ نَفْسَهُ مَخْنُوقَ الْعَبَرَاتِ:"
        },
        {
            "id": 28,
            "text": "(لَقَدْ أَغْلَقَ بَابَ جُحْرِهِ فِي وَجْهِي!"
        },
        {
            "id": 29,
            "text": "كَمْ كُنْتُ أَتَمَنَّى لَوْ أَنَّ لِي جُحْراً دَافِئاً أَخْتَبِئُ فِيهِ"
        },
        {
            "id": 30,
            "text": "أَوْ حَجْماً صَغِيراً يَتَنَاسَبُ مَعَ مَجَالِسِهِمْ"
        },
        {
            "id": 31,
            "text": "لِمَ خُلِقْتُ بِهَذَا الْحَجْمِ الْكَبِيرِ إِذَا كَانَ سَبَباً لِوَحْدَتِي؟)"
        },
        {
            "id": 32,
            "text": "تَابَعَ الْفِيلُ طَرِيقَهُ وَهُوَ يَشْعُرُ بِثِقْلٍ فِي قَلْبِهِ قَبْلَ قَدَمَيْهِ"
        },
        {
            "id": 33,
            "text": "فَالْتَقَى ثَعْلَباً مَكَّاراً",
            "imageAsset": "/audio/stories/Elephant_and_friends/scene_33.png"
        },
        {
            "id": 34,
            "text": "فَسَأَلَهُ أَيْضاً إِنْ كَانَ يَقْبَلُ بِصُدَاقَتِهِ"
        },
        {
            "id": 35,
            "text": "فَقَالَ الثَّعْلَبُ مُتَكَبِّراً:"
        },
        {
            "id": 36,
            "text": "\"أَنْتَ ضَخْمٌ جِدّاً وَثَقِيلُ الْحَرَكَةِ"
        },
        {
            "id": 37,
            "text": "وَلَا تَسْتَطِيعُ الْجَرْيَ بِسُرْعَةٍ مِثْلِي"
        },
        {
            "id": 38,
            "text": "أَنَا آسِفٌ"
        },
        {
            "id": 39,
            "text": "لَكِنَّكَ لَا تَصْلُحُ لِتَكُونَ صَدِيقِي\""
        },
        {
            "id": 40,
            "text": "تَنَهَّدَ الْفِيلُ بِعُمْقٍ وَأَجْرَى حِوَاراً مَعَ ذَاتِهِ يَقُولُ فِيهِ:"
        },
        {
            "id": 41,
            "text": "(هَذَا هُوَ السَّبَبُ إِذاً!"
        },
        {
            "id": 42,
            "text": "السُّرْعَةُ وَالرَّقْصُ السَّرِيعُ"
        },
        {
            "id": 43,
            "text": "لَيْتَنِي أَمْتَلِكُ سَاقَيْنِ خَفِيفَتَيْنِ أُسَابِقُ بِهِمَا الرِّيحَ"
        },
        {
            "id": 44,
            "text": "حَتَّى لَا أَبْقَى وَحِيداً هَكَذَا هَائِماً عَلَى وَجْهِي!)"
        },
        {
            "id": 45,
            "text": "وَفِي الْيَوْمِ التَّالِي"
        },
        {
            "id": 46,
            "text": "بَيْنَمَا كَانَتِ الْغَابَةُ تَعِيشُ فِي هُدُوءٍ"
        },
        {
            "id": 47,
            "text": "هَبَّتْ رِيحُ الرُّعْبِ؛ إِذْ انْتَشَرَتْ جَمِيعُ حَيَوَانَاتِ الْغَابَةِ تَرْكُضُ فِي خَوْفٍ شَدِيدٍ وَهَلَعٍ عَارِمٍ",
            "imageAsset": "/audio/stories/Elephant_and_friends/scene_47.png"
        },
        {
            "id": 48,
            "text": "أَوْقَفَ الْفِيلُ دُبّاً كَانَ يَهْرُبُ بِسُرْعَةٍ"
        },
        {
            "id": 49,
            "text": "وَسَأَلَهُ عَمَّا يَجْرِي"
        },
        {
            "id": 50,
            "text": "فَأَجَابَهُ وَهْوَ يَلْتَفِتُ خَلْفَهُ بِخَوْفٍ:"
        },
        {
            "id": 51,
            "text": "\"إِنَّ نَمْراً مُفْتَرِساً يَهْجُمُ عَلَى الْجَمِيعِ وَيُرِيدُ إِذَايَتَنَا\""
        },
        {
            "id": 52,
            "text": "لَمْ يَترَدَّدِ الْفِيلُ الطَّيِّبُ لَحْظَةً وَاحِدَةً؛ فَقَدْ أَرَادَ حِمَايَةَ الْحَيَوَانَاتِ الضَّعِيفَةِ وَإِنْقَاضَهَا"
        },
        {
            "id": 53,
            "text": "وَتَوَجَّهَ بِشَجَاعَةٍ نَحْوَ النَّمْرِ وَقَالَ لَهُ بِصَوْتٍ حَازِمٍ:",
            "imageAsset": "/audio/stories/Elephant_and_friends/scene_53.png"
        },
        {
            "id": 54,
            "text": "\"أَرْجُوكَ يَا سَيِّدِي"
        },
        {
            "id": 55,
            "text": "اتْرُكْ أَصْدِقَائِي وَشَأْنَهُمْ وَلَا تُؤْذِهِمْ\""
        },
        {
            "id": 56,
            "text": "لَمْ يَسْتَمِعِ النَّمْرُ لِكَلِمَاتِهِ"
        },
        {
            "id": 57,
            "text": "بَلْ تَكَبَّرَ وَطَلَبَ مِنَ الْفِيلِ أَنْ يَهْتَمَّ بِشُؤُونِهِ خَاصَّةً وَأَنْ يَبْتَعِدَ عَنْ طَرِيقِهِ"
        },
        {
            "id": 58,
            "text": "وَنَظَراً لِعَدَمِ وُجُودِ طَرِيقَةٍ أُخْرَى لِحَلِّ هَذِهِ الْمُشْكِلَةِ"
        },
        {
            "id": 59,
            "text": "تَقَدَّمَ الْفِيلُ بِثَبَاتٍ وَهَدَّدَ النَّمْرَ بِرَكْلِهِ بَعِيداً إِنْ لَمْ يُغَادِرِ الْمَكَانَ فَوْراً"
        },
        {
            "id": 60,
            "text": "خَافَ النَّمْرُ مِنْ حَجْمِ الْفِيلِ وَقُوَّتِهِ الْهَائِلَةِ"
        },
        {
            "id": 61,
            "text": "فَوَلَّى هَارِباً يَبْحَثُ عَنْ مَخْبَأٍ حَتَّى نَجَتِ الْحَيَوَانَاتُ",
            "imageAsset": "/audio/stories/Elephant_and_friends/scene_61.png"
        },
        {
            "id": 62,
            "text": "وَبَعْدَمَا رَأَتْ جَمِيعُ حَيَوَانَاتِ الْغَابَةِ كَيْفَ أَنْقَذَ الْفِيلُ حَيَاتَهُمْ بِشَجَاعَتِهِ"
        },
        {
            "id": 63,
            "text": "اقْتَرَبُوا مِنْهُ بِمَحَبَّةٍ وَاعْتِذَارٍ"
        },
        {
            "id": 64,
            "text": "وَوَافَقُوا جَمِيعاً فِي انْسِجَامٍ تَامٍ عَلَى أَنْ يَكُونَ الْفِيلُ صَدِيقَهُمْ الدَّائِمَ",
            "imageAsset": "/audio/stories/Elephant_and_friends/scene_64.png"
        },
        {
            "id": 65,
            "text": "وَقَالُوا لَهُ بِامْتِنَانٍ:"
        },
        {
            "id": 66,
            "text": "\"أَنْتَ حَقّاً بِالْحَجْمِ الْمُنَاسِبِ لِتَكُونَ صَدِيقَنَا الْحَقِيقِيَّ\""
        },
        {
            "id": 67,
            "text": "بَسَمَ الْفِيلُ بَيْنَهُ وَبَيْنَ نَفْسِهِ"
        },
        {
            "id": 68,
            "text": "وَأَدْرَكَ حِينَها بِعُمْقٍ:"
        },
        {
            "id": 69,
            "text": "(تِلْكَ الْمُصَافَاتُ وَالصِّفَاتُ الَّتِي عَابُوهَا عَلَيَّ"
        },
        {
            "id": 70,
            "text": "لَمْ تُسْعِفْهُمْ يَوْماً لِلْوُقُوفِ فِي وَجْهِ النَّمْرِ؛ فَلَمْ يَنْفَعْهُمْ التَّأَرْجُحُ"
        },
        {
            "id": 71,
            "text": "وَلَا ضِيقُ الْجُحُورِ"
        },
        {
            "id": 72,
            "text": "وَلَا سُرْعَةُ الْجَرْيِ"
        },
        {
            "id": 73,
            "text": "بَلْ كَانَتْ ضَخَامَتِي وَقُوَّتِي هُمَا دِرْعَ النَّجَاةِ لِلْجَمِيعِ!)"
        },
        {
            "id": 74,
            "text": "وَتَعَلَّمَ الْجَمِيعُ يَوْمَهَا دَرْساً لَنْ يَنْسَوْهُ؛ وَهُوَ أَنَّ الْأَصْدِقَاءَ يَأْتُونَ بِكُلِّ الْأَشْكَالِ وَالْأَحْجَامِ"
        },
        {
            "id": 75,
            "text": "فَلَيْسَتِ الْمَظَاهِرُ وَالْأَحْجَامُ هِيَ الْمُهِمَّةَ"
        },
        {
            "id": 76,
            "text": "وَلَا أَلْوَانُ الْبَشَرَةِ وَلَا كَثْرَةُ الْأَمْوَالِ"
        },
        {
            "id": 77,
            "text": "بَلِ الْقُلُوبُ الطَّيِّبَةُ وَالْأَعْمَالُ النَّبِيلَةُ هِيَ الْأَحْسَنُ وَالْأَبْقَى"
        }
    ]
}